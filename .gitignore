# Zenodo layer (28 GB archive, split volumes) lives outside git — "zenodo" is a symlink here, so no trailing slash
zenodo
zenodo_v2
zenodo_v1_old
# large proof files never go into the GitHub layer (only the small ones are tracked)
*.drat
*.lrat
!cubes/cover_pure.drat
!L3/L3.drat
# v1.1 layer: the same three kinds of small certificate.  Without these
# negations `*.drat` silently drops the cover certificate and both copies of
# the L3'' assembly proof, which are exactly the files the release needs.
# best_S315/L2L3/*/spindle_B/spindle.drat stays excluded on purpose: 517 MiB,
# over GitHub's 100 MB limit, fingerprinted in best_S315/README.md instead.
!best_S315/L1pp/cnc_r05a/cover_pure.drat
!best_S315/L2L3/l3/L3pp.drat
!best_S315/L2L3/l3_final/L3pp.drat
# scratch output of rerun.sh
rebuild/
tmp_verify/
__pycache__/
*.pyc
*.tmp
