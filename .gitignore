# Zenodo layer (28 GB archive, split volumes) lives outside git — "zenodo" is a symlink here, so no trailing slash
zenodo
zenodo_v2
zenodo_v1_old
# large proof files never go into the GitHub layer (only the small ones are tracked)
*.drat
*.lrat
!cubes/cover_pure.drat
!L3/L3.drat
# v1.1 layer: the same three kinds of small certificate.  Without these
# negations `*.drat` silently drops the cover certificate and both copies of
# the L3'' assembly proof, which are exactly the files the release needs.
# best_S315/L2L3/*/spindle_B/spindle.drat stays excluded on purpose: 517 MiB,
# over GitHub's 100 MB limit, fingerprinted in best_S315/README.md instead.
!best_S315/L1pp/cnc_r05a/cover_pure.drat
!best_S315/L2L3/l3/L3pp.drat
!best_S315/L2L3/l3_final/L3pp.drat
# reduction_S60: same two kinds of small certificate.  Its 16384 leaf proofs
# (95.2 GiB) are not in the repository at all and stay covered by `*.drat`.
!reduction_S60/cnc/cover_pure.drat
!reduction_S60/l3_phase3_round2/L3p.drat
# reduction_S30: likewise.  Its leaf proofs were never retained at all.
!reduction_S30/cnc/cover_pure.drat
!reduction_S30/l3/L3p.drat
#
# NOTE for whoever adds the next layer: `*.drat` above has silently swallowed
# the cover certificate and the L3 proof three times now (best_S315,
# reduction_S60, reduction_S30).  After copying a new layer in, run
#     find <layer> -name '*.drat' -exec git check-ignore -v {} +
# and add a negation for every small certificate it prints.  reduction_blocked
# has no .drat at all: those batches are SAT, and the certificate is a colouring.
# scratch output of rerun.sh
rebuild/
tmp_verify/
__pycache__/
*.pyc
*.tmp
